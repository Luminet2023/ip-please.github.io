# 复制为 .env 后填写；不要提交真实密码。
# MySQL：复用服务器已有数据库，服务只会创建 ip_please_* 前缀的表。
# - 数据库是独立/远程实例：直接写它的地址，例如 mysql://user:pass@10.0.0.5:3306/game
# - 数据库跑在宿主机上（不是容器）：容器内的 127.0.0.1 指的是容器自己，需改用
#   mysql://user:pass@host.docker.internal:3306/game，并在 compose 里打开 extra_hosts
# - 数据库在另一个 compose 网络里：加入同一网络，写服务名，例如 mysql://user:pass@mysql:3306/game
# 账号需要该库的 CREATE 权限（启动时幂等建表）。
SYNC_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE

# IdP（Keycloak）
OIDC_ISSUER=https://auth.luminet.cn/realms/prod
OIDC_CLIENT_ID=app_vXmK3nB7cmKcW6q7
OIDC_REQUIRED_SCOPE=openid

# 允许跨域来源（游戏线上域名 + 本地调试）
ALLOWED_ORIGINS=https://www.fuckanthropic.dev,https://fuckanthropic.dev,http://localhost:8000

# 服务
BIND_ADDR=0.0.0.0:8080
SYNC_MAX_PAYLOAD_BYTES=262144
SYNC_RATE_LIMIT_SECONDS=3
RUST_LOG=info,sqlx=warn
