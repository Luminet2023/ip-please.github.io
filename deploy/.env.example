# 复制为 .env 后填写；不要提交真实密码。
# MySQL：复用服务器已有数据库，服务只会创建 ip_please_* 前缀的表。
# - 数据库是独立/远程实例：直接写它的地址，例如 mysql://user:pass@10.0.0.5:3306/game
# - 数据库跑在宿主机上（不是容器）：容器内的 127.0.0.1 指的是容器自己，需改用
#   mysql://user:pass@host.docker.internal:3306/game，并在 compose 里打开 extra_hosts
# - 数据库在另一个 compose 网络里：加入同一网络，写服务名，例如 mysql://user:pass@mysql:3306/game
# 账号需要该库的 CREATE 权限（启动时幂等建表）。
SYNC_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE

# 会话签名密钥（必填，至少 32 字节）：install.sh 首次运行会自动生成。
# 手动生成：openssl rand -hex 32。轮换时把旧值挪到 SESSION_JWT_SECRET_PREVIOUS，过 10 分钟后删掉。
SESSION_JWT_SECRET=CHANGE_ME
# SESSION_JWT_SECRET_PREVIOUS=

# 无尽模式每日挑战的种子密钥（必填，至少 32 字节）：install.sh 首次运行会自动生成。
# 一旦上线不要更换，否则当天的每日挑战旅客序列会变。
ENDLESS_SEED_SECRET=CHANGE_ME

# IdP（Keycloak）。后端在服务器端换码；客户端切成机密客户端后填 OIDC_CLIENT_SECRET。
OIDC_ISSUER=https://auth.luminet.cn/realms/prod
OIDC_CLIENT_ID=app_vXmK3nB7cmKcW6q7
# OIDC_CLIENT_SECRET=
# 回调地址（必须同时登记在 Keycloak 的 Valid redirect URIs）
OIDC_REDIRECT_URIS=https://www.fuckanthropic.dev/,http://localhost:8000/
OIDC_SCOPE=openid profile
# 管理员：Keycloak 客户端角色名，以及（可选）把角色写进 ID Token 的 mapper claim 名
OIDC_ADMIN_ROLE=ip-please-admin
OIDC_ROLES_CLAIM=ip_please_roles
# 玩家名字 / 头像取自 ID Token：名字依次尝试这些 claim（像邮箱的值跳过），头像只收 https 地址
# OIDC_NAME_CLAIMS=name,nickname,preferred_username
# OIDC_AVATAR_CLAIM=picture

# 本服务签发的 Access Token
TOKEN_ISSUER=https://api.luminet.cn/anthropic
ACCESS_TOKEN_TTL_SECONDS=600
SESSION_IDLE_DAYS=14
SESSION_MAX_DAYS=30
# nginx 写入真实客户端 IP 的请求头（限流用）
CLIENT_IP_HEADER=x-real-ip

# 允许跨域来源（游戏线上域名 + 本地调试）
ALLOWED_ORIGINS=https://www.fuckanthropic.dev,https://fuckanthropic.dev,http://localhost:8000

# 服务
BIND_ADDR=0.0.0.0:8080
SYNC_MAX_PAYLOAD_BYTES=262144
SYNC_RATE_LIMIT_SECONDS=3
RUST_LOG=info,sqlx=warn

# 可选：镜像 tag，默认 latest；回滚时改成 sha-<短哈希> 或 build-<短哈希>
# IMAGE_TAG=latest
